# Base 主網 demo 設定樣板。全部憑證留白；勿提交實際 .env。
# 尚未部署；不要沿用 Base Sepolia 的合約地址或測試私鑰。
# 請用獨立 demo 錢包，只放經人工確認的少量 gas ETH。
RPC_URL=
EXPECTED_CHAIN_ID=8453
# 必須人工改成 true 才允許腳本在 Base 主網執行（含 dry-run）。
ALLOW_BASE_MAINNET=false

DEPLOYER_PRIVATE_KEY=
GUARDIAN_ADDRESS=
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
# 主網必填。0=不補款；非零值是目標餘額，不是每次固定匯款額。
OPERATOR_GAS_WEI=
BUYER_PRIVATE_KEY=
SELLER_ADDRESS=
LEGACY_ORACLE_ADDRESS=
LEGACY_ORACLE_PRIVATE_KEY=

# 由 Base 主網新部署結果填入，不能複製 Sepolia 的地址。
TOKEN_ADDRESS=
ESCROW_ADDRESS=
DECOY_TOKEN_ADDRESS=
TITLE_SUFFIX=-base-demo-1
ESCROW_ID=

# 只供 PrepareRiskyApproval.s.sol 產生未簽名掃描參數；不要送出授權。
# owner 應對應平台 OPERATION 的 operator；spender 待實測後由平台工程師提供。
APPROVAL_OWNER_ADDRESS=
RISKY_SPENDER_ADDRESS=

# 舊版 GuardExecutor 不在本次 demo 路徑，維持空白。
PLATFORM_SIGNER_ADDRESS=
APPROVER_ADDRESS=
GUARD_ADDRESS=
ETHERSCAN_API_KEY=

# Intercepta key 僅放 Secueji 平台的 .env，本 repo 不需要 API key。
