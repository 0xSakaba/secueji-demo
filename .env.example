# Copy to .env and fill in. Never commit .env.
# Load it into your shell before running scripts:  set -a; source .env; set +a

# RPC endpoint. Local anvil by default; for a testnet use your provider URL
# (for example an Alchemy HTTPS endpoint).
RPC_URL=http://127.0.0.1:8545

# Key that deploys the contracts. It becomes the DemoStablecoin minter, the
# DemoEscrow admin and the GuardExecutor owner.
# For local anvil, use one of the private keys anvil prints on startup.
DEPLOYER_PRIVATE_KEY=

# Address whose EIP-712 signatures authorize guarded releases (platform signer).
PLATFORM_SIGNER_ADDRESS=

# Human approver registered on GuardExecutor at deploy time.
APPROVER_ADDRESS=

# --- Testnet contract verification (optional) ---
ETHERSCAN_API_KEY=
