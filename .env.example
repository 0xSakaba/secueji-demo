# Copy to .env and fill in. Never commit .env.
# Load it into your shell before running scripts:  set -a; source .env; set +a
# Then export ETH_RPC_URL="$RPC_URL" and pass --rpc-url "$ETH_RPC_URL".

# RPC endpoint. Local anvil by default; for a testnet use your provider URL
# (for example an Alchemy HTTPS endpoint).
RPC_URL=http://127.0.0.1:8545

# 中文：所有腳本先比對 RPC chain id。Anvil=31337、Base Sepolia=84532。
# Base 主網使用 .env.base-mainnet.example，必須另外明確 opt-in。
EXPECTED_CHAIN_ID=31337
ALLOW_BASE_MAINNET=false

# Customer key that deploys the contracts. It becomes the DemoStablecoin
# minter, the DemoEscrow admin and the default DemoEscrow guardian.
# For local anvil, use one of the private keys anvil prints on startup.
DEPLOYER_PRIVATE_KEY=

# Optional: account allowed to pause DemoEscrow at deploy time. Defaults to the
# deployer. OnboardOperator.s.sol later hands the guardian role to the operator.
GUARDIAN_ADDRESS=

# --- Secueji operator account ---
# The account the customer hands to secueji at onboarding. It is the oracle of
# the escrows secueji releases and the escrow guardian (pause only).
# OnboardOperator.s.sol, Seed.s.sol: OPERATOR_ADDRESS.
# OperatorRelease.s.sol, GuardianPause.s.sol: OPERATOR_PRIVATE_KEY.
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
# Optional: ETH balance OnboardOperator.s.sol tops the operator up to (wei).
# 中文：僅 local/Sepolia 預設 0.01 ETH；主網必填，填 0 表示不補款。
OPERATOR_GAS_WEI=

# --- Seed script only (script/Seed.s.sol) ---
# Buyer key: receives minted dUSD, deploys the decoy dUSD token and funds the
# demo escrows.
BUYER_PRIVATE_KEY=
SELLER_ADDRESS=
# Old oracle EOA outside secueji; oracle of the bypass-scenario escrows.
LEGACY_ORACLE_ADDRESS=
# Addresses printed by script/Deploy.s.sol.
TOKEN_ADDRESS=
ESCROW_ADDRESS=
# Optional: reuse an existing decoy token instead of deploying a new one.
DECOY_TOKEN_ADDRESS=
# Optional: appended to every titleId label (for example -2 on a re-seed).
TITLE_SUFFIX=

# 中文：僅供高風險授權唯讀準備腳本；不讀私鑰、不呼叫 approve。
APPROVAL_OWNER_ADDRESS=
RISKY_SPENDER_ADDRESS=

# --- Demo scenario scripts only (script/scenarios/) ---
# Old oracle key, used by BypassRelease.s.sol to release outside secueji.
LEGACY_ORACLE_PRIVATE_KEY=

# --- GuardExecutor (earlier design, not on the demo path; optional) ---
# Deploy.s.sol deploys GuardExecutor only when PLATFORM_SIGNER_ADDRESS is set.
PLATFORM_SIGNER_ADDRESS=
APPROVER_ADDRESS=
GUARD_ADDRESS=

# --- Testnet contract verification (optional) ---
ETHERSCAN_API_KEY=
